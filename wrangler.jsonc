{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webskan",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-04",
  "observability": { "enabled": true },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "durable_objects": { "bindings": [{ "name": "SCAN_QUEUE", "class_name": "ScanQueue" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ScanQueue"] }],
  "kv_namespaces": [
    { "binding": "ORDERS", "id": "a3f4667b50d34ecba4aaf23578f5783b" }
  ],
  "vars": {
    "POLAR_API": "https://api.polar.sh",
    "SALES_MODE": "presale",
    "PRICE_PL": "99 zł",
    "PRICE_EN": "$29"
  }
}
