{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webskan",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-04",
  "observability": { "enabled": true },
  "workers_dev": true,
  "routes": [
    { "pattern": "webskan.com", "custom_domain": true },
    { "pattern": "www.webskan.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "durable_objects": { "bindings": [{ "name": "SCAN_QUEUE", "class_name": "ScanQueue" }, { "name": "MONITOR_HUB", "class_name": "MonitorHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ScanQueue"] }, { "tag": "v2", "new_sqlite_classes": ["MonitorHub"] }],
  "triggers": { "crons": ["* * * * *"] },
  "kv_namespaces": [
    { "binding": "ORDERS", "id": "a3f4667b50d34ecba4aaf23578f5783b" }
  ],
  "vars": {
    "POLAR_API": "https://api.polar.sh",
    "POLAR_ORG_ID": "4eb0c880-2ae5-4820-882d-0d5b22d489f4",
    "SALES_MODE": "presale",
    "PRICE_PL": "99 zł",
    "PRICE_EN": "$29"
  }
}
