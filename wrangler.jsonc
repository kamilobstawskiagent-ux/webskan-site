{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webskan",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-04",
  "observability": { "enabled": true, "head_sampling_rate": 0.05 },
  "workers_dev": true,
  "routes": [
    { "pattern": "webskan.com", "custom_domain": true },
    { "pattern": "www.webskan.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "durable_objects": { "bindings": [{ "name": "SCAN_QUEUE", "class_name": "ScanQueue" }, { "name": "MONITOR_HUB", "class_name": "MonitorHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ScanQueue"] }, { "tag": "v2", "new_sqlite_classes": ["MonitorHub"] }],
  "triggers": { "crons": ["* * * * *"] },
  "kv_namespaces": [
    { "binding": "ORDERS", "id": "a3f4667b50d34ecba4aaf23578f5783b" }
  ],
  "vars": {
    "POLAR_API": "https://api.polar.sh",
    "POLAR_ORG_ID": "4eb0c880-2ae5-4820-882d-0d5b22d489f4",
    "POLAR_PRODUCT_DEVELOPER": "86390ffb-2032-4455-8495-2bf5fb584834",
    "POLAR_PRODUCT_AGENCY": "33b18842-8ada-43d3-8bac-c74e5b9d7e6a",
    "POLAR_PRODUCT_AGENCY30": "82ed0479-7f7f-4dfd-a590-be9de02cc2d4",
    "POLAR_PRODUCT_DEPS3_PL": "67f67175-d381-4ff6-8b76-a16cecfe8356",
    "POLAR_PRODUCT_DEPS10_PL": "a5f5d54c-875f-4b35-9845-ee2979469f49",
    "POLAR_PRODUCT_DEPS3_EN": "87e82e7f-ec7e-44e2-9602-6d9756aa22fd",
    "POLAR_PRODUCT_DEPS10_EN": "20d977a9-b94c-49a0-ad16-1eea42d6bb80"
  }
}
